# HTTP
PORT=3000
LOG_LEVEL=info

# MySQL
DATABASE_URL=mysql://root:password@localhost:3306/alaje

# Meta WhatsApp Cloud API
# Token you choose; Meta echoes it back on the GET webhook verification handshake.
WHATSAPP_VERIFY_TOKEN=change-me
# App Secret from the Meta app dashboard — used for X-Hub-Signature-256 verification.
WHATSAPP_APP_SECRET=change-me
# Permanent/system-user access token used to send outbound messages.
WHATSAPP_TOKEN=change-me
# Phone Number ID (NOT the phone number itself) from the WhatsApp > API Setup page.
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_GRAPH_VERSION=v21.0
