# HTTP
PORT=3000
LOG_LEVEL=info

# MySQL
DATABASE_URL=mysql://root:password@localhost:3306/alaje

# Meta WhatsApp Cloud API
# Token you choose; Meta echoes it back on the GET webhook verification handshake.
WHATSAPP_VERIFY_TOKEN=change-me
# App Secret from the Meta app dashboard — used for X-Hub-Signature-256 verification.
WHATSAPP_APP_SECRET=change-me
# Permanent/system-user access token used to send outbound messages.
WHATSAPP_TOKEN=change-me
# Phone Number ID (NOT the phone number itself) from the WhatsApp > API Setup page.
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_GRAPH_VERSION=v21.0

# LLM provider (any OpenAI-compatible gateway).
# OpenRouter: https://openrouter.ai/api/v1   DeepSeek: https://api.deepseek.com/v1
# Pick a model that supports tool calling; one that does not will answer in
# prose and never emit a tool call, which looks like a broken agent.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_API_KEY=change-me
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=30000

# Agent loop
AGENT_MAX_ITERATIONS=3
AGENT_HISTORY_TURNS=10
